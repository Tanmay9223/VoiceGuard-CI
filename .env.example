# ============================================================
# VoiceGuard CI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# --- LLM (required for real runs and demos) ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- STT (required when USE_AUDIO_PIPELINE=true) ---
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# --- TTS (required when USE_AUDIO_PIPELINE=true) ---
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# --- Database ---
# SQLite for local dev; swap to postgresql://... for production
DATABASE_URL=sqlite:///data/eval.db

# --- Audio pipeline ---
# Set to true ONLY to run the asr-noise-injection scenario (TTS→STT round-trip).
# All other scenarios use text-only mode regardless of this flag.
USE_AUDIO_PIPELINE=false

# --- Mock LLM ---
# Set to true in CI / offline testing to skip all Gemini API calls.
# Uses fixture responses from harness/providers.py (MockLLMProvider).
MOCK_LLM=false
